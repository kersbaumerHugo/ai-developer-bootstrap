{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-local/qwen3.5-9b-local",
  "providers": {
    "llama-local": {
      "name": "Qwen Local (llama.cpp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "{env:QWEN_API_KEY}"
      },
      "models": {
        "qwen3.5-9b-local": {
          "modelID": "qwen3.5-9b-local",
          "name": "Qwen 3.5 9B Local",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
